<mvc:View
    controllerName="zpeweb.controller.Cockpit"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns="sap.m">
    
    <Page 
        id="cockpitPage" 
        title="{i18n>cockpitTitle}" 
        showNavButton="false" 
        enableScrolling="true"
        backgroundDesign="List">

        <headerContent>
            <Button 
                id="btnNotifications"
                icon="sap-icon://bell" 
                type="{= ${viewModel>/criticalCount} > 0 ? 'Reject' : 'Transparent' }"
                text="{= ${viewModel>/criticalCount} > 0 ? ${viewModel>/criticalCount} : '' }"
                tooltip="Notificações de Estoque"
                press=".onOpenNotifications" />
            <Button 
                icon="sap-icon://palette" 
                type="Transparent"
                tooltip="{i18n>tooltipToggleTheme}"
                press=".onToggleTheme" />
        </headerContent>

        <!-- 2. A CAIXA FLUTUANTE DE NOTIFICAÇÕES (Oculta até o clique) -->
        <dependents>
            <Popover 
                id="notificationsPopover" 
                title="Alertas Críticos ({viewModel>/criticalCount})" 
                placement="Bottom" 
                contentWidth="320px"
                class="sapUiContentPadding">
                <content>
                    <List 
                        id="listCriticalStock"
                        noDataText="🎉 Tudo certo! Nenhum Produto Acabado zerado."
                        items="{viewModel>/criticalItems}">
                        <items>
                            <NotificationListItem 
                                title="{viewModel>Codigom} - {viewModel>Descricaocm}" 
                                description="Estoque esgotado. Verifique a necessidade de compra imediata."
                                priority="High"
                                showCloseButton="false"
                                press=".onCriticalItemPress" />
                        </items>
                    </List>
                </content>
            </Popover>
        </dependents>
        
        <content>
            
            <HBox id="headerBox" class="sapUiMediumMargin" alignItems="Center">
                <Avatar 
                    id="userAvatar"
                    src="sap-icon://retail-store" 
                    displaySize="M" 
                    displayShape="Square"
                    class="sapUiSmallMarginEnd"/>
                
                <VBox id="welcomeBox" justifyContent="Center">
                    <Title id="welcomeText" text="{i18n>welcomeMessage}" level="H1" titleStyle="H4" />                
                    <Text id="descriptionText" text="{i18n>cockpitDescription}" class="sapUiThemeTextMuted" />
                </VBox>
            </HBox>

            
            <VBox id="functionsBox" class="sapUiMediumMarginBeginEnd">
                <Title id="functionsLabel" text="{i18n>availableFunctions}" level="H2" titleStyle="H4" class="sapUiSmallMarginBottom"/>
                <Panel headerText="Operações" class="sapUiSmallMargin">
                    <grid:CSSGrid 
                        id="dashboardGrid"
                        gridTemplateColumns="repeat(auto-fit, 11rem)" 
                        gridGap="1rem">

                        <GenericTile 
                            id="inventoryTile"
                            header="Gestão de Estoque"
                            subheader="Consulta e Movimentação"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="inventory"/>
                            </customData>
                            <TileContent id="inventoryContent">
                                <NumericContent 
                                    id="inventoryNumeric"
                                    icon="sap-icon://product"
                                    value="{viewModel>/TotalEstoque}" 
                                    valueColor="Good"
                                    withMargin="false"/>
                            </TileContent>
                        </GenericTile>
                        
                        <GenericTile 
                            id="cadastrarBom"
                            header="Estrutura de Produto (BOM)"
                            subheader="Receita de produção"
                            frameType="OneByOne"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="cadastrobom"/>
                            </customData>
                            <TileContent id="bomContent">
                                <ImageContent id="bomIcon" src="sap-icon://course-book" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile 
                            id="executarProducao"
                            header="Executar Produção"
                            subheader="Gerar Produto Acabado"
                            frameType="OneByOne"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="executar"/>
                            </customData>
                            <TileContent id="executarContent">
                                <ImageContent id="executarIcon" src="sap-icon://factory" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile 
                            id="centralCompras"
                            header="Central de compras"
                            subheader="Controle de pedidos"
                            frameType="OneByOne"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="centralcompras"/>
                            </customData>
                            <TileContent id="comprasContent">
                                <ImageContent id="comprasIcon" src="sap-icon://credit-card" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile 
                            id="reportsTile"
                            header="Relatórios"
                            subheader="Extrações e Histórico"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="reports"/>
                            </customData>
                            <TileContent id="reportsContent">
                                <ImageContent id="reportsNumeric" src="sap-icon://bar-chart"/>
                            </TileContent>
                        </GenericTile>

                    </grid:CSSGrid>
                </Panel>
                <Panel headerText="Manutenção" class="sapUiSmallMargin">
                    <grid:CSSGrid 
                        gridTemplateColumns="repeat(auto-fit, 11rem)" 
                        gridGap="1rem">

                        <GenericTile 
                            id="cadastroMaterial"
                            header="Cadastro de Material"
                            subheader="Cadastrar novo material"
                            frameType="OneByOne"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="cadastroMaterial"/>
                            </customData>
                            <TileContent id="cadastroMaterialContent">
                                <ImageContent id="cadastroMaterialIcon" src="sap-icon://add-product" />
                            </TileContent>
                        </GenericTile>
                        
                        <GenericTile 
                            id="unidadeMedida"
                            header="Unidades de Medida"
                            subheader="Cadastrar nova unidade"
                            frameType="OneByOne"
                            press=".onCardPress">
                            <customData>
                                <core:CustomData key="route" value="unidademedida"/>
                            </customData>
                            <TileContent id="unidadeContent">
                                <ImageContent id="unidadeIcon" src="sap-icon://sys-add" />
                            </TileContent>
                        </GenericTile>
                    </grid:CSSGrid>
                </Panel>
            </VBox>
        </content>

        <footer>
            <Bar id="footerBar" design="Auto">
                <contentRight>
                    <Text id="versionText" text="{i18n>version}" class="sapUiTinyMarginEnd sapUiThemeTextMuted"/>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>