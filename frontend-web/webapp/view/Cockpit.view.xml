<mvc:View
    controllerName="zpeweb.controller.Cockpit"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    
    <Page id="cockpitPage" title="{i18n>cockpitTitle}" showNavButton="false" enableScrolling="true">
        <content>
            
            <VBox id="headerBox" class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop sapUiSmallMarginBottom sapUiTinyGap">
                <Title id="welcomeText" text="{i18n>welcomeMessage}" level="H2" titleStyle="H2" />                
                <Text id="descriptionText" text="{i18n>cockpitDescription}" />
            </VBox>

            <VBox id="functionsBox" class="sapUiMediumMarginBeginEnd">
                <Title id="functionsLabel" text="{i18n>availableFunctions}" level="H4" titleStyle="H5" class="sapUiSmallMarginBottom"/>
                
                <FlexBox 
                    id="cardsFlexBox"
                    renderType="Bare" 
                    wrap="Wrap"
                    class="sapUiSmallGap">
                    
                    <GenericTile 
                        id="inventoryTile"
                        header="Gestão de Estoque"
                        subheader="{i18n>inventoryDescription}"
                        wrappingType="Normal"
                        press=".onCardPress"
                        class="sapUiTinyMargin">
                        <customData>
                            <core:CustomData key="route" value="inventory"/>
                        </customData>
                        <TileContent id="inventoryContent">
                            <NumericContent 
                                id="inventoryNumeric"
                                icon="sap-icon://product"
                                value=""
                                valueColor="Good"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile 
                        id="reportsTile"
                        header="Relatórios"
                        subheader="{i18n>reportsDescription}"
                        wrappingType="Normal"
                        press=".onCardPress"
                        class="sapUiTinyMargin">
                        <customData>
                            <core:CustomData key="route" value="reports"/>
                        </customData>
                        <TileContent id="reportsContent">
                            <NumericContent 
                                id="reportsNumeric"
                                icon="sap-icon://bar-chart"
                                value=""
                                valueColor="Neutral"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>

                </FlexBox>
            </VBox>

        </content>

        <footer>
            <Bar id="footerBar" class="sapUiSmallPadding">
                <contentRight>
                    <Text id="versionText" text="{i18n>version}" class="sapUiTinyMargin"/>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>