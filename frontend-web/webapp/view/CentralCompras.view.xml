<mvc:View controllerName="zpeweb.controller.CentralCompras"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="comprasPage"
        title="{i18n>comprasPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <content>
            <VBox class="sapUiSmallMargin">
                
                <!-- Barra superior: busca e buscar todos -->
                <FlexBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    
                    <!-- Buscar PA -->
                    <HBox alignItems="Center">
                        <Label text="Selecionar Produto Acabado:" labelFor="inputProdutoAcabado" class="sapUiTinyMarginEnd" />
                        <Input id="inputProdutoAcabado"
                            width="200px"
                            type="Number"
                            placeholder="Digite o código..."
                            showValueHelp="true"
                            valueHelpRequest=".onValueHelpProduto"
                            liveChange=".onInputLiveChange"
                            class="sapUiTinyMarginEnd" />
                        <Button id="btnBuscar"
                            text="Buscar"
                            type="Emphasized"
                            icon="sap-icon://search"
                            press=".onBuscar" />
                    </HBox>

                    <!-- Botao Select All -->
                    <Button id="btnBuscarTodos"
                        text="Buscar Todos"
                        icon="sap-icon://multi-select"
                        press=".onBuscarTodos" />

                </FlexBox>

                <VBox id="panelResultadoCompras" class="sapUiSmallMarginTop" visible="false">
                    
                    <!-- tabela nececidade compra -->
                    <Table id="tblPedidoCompra" 
                        mode="MultiSelect"
                        inset="false" 
                        class="sapUiSmallMarginBottom"
                        items="{comprasModel>/}">
                        <columns>
                            <Column width="12%">
                                <Text text="Cod. Prod. Final" />
                            </Column>
                            <Column width="22%">
                                <Text text="Descrição PA" />
                            </Column>
                            <Column width="12%">
                                <Text text="Cod. Mat. Prima" />
                            </Column>
                            <Column width="22%">
                                <Text text="Descrição MP" />
                            </Column>
                            <Column hAlign="End" width="11%">
                                <Text text="Qtd. Necessária" />
                            </Column>
                            <Column hAlign="End" width="11%">
                                <Text text="Qtd. em Estoque" />
                            </Column>
                            <Column hAlign="End" width="10%">
                                <Text text="Qtd. a Comprar" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{comprasModel>Codigopa}" />
                                    <Text text="{comprasModel>Descricaopa}" />
                                    <Text text="{comprasModel>Codigomp}" />
                                    <Text text="{comprasModel>Descricaomp}" />
                                    <ObjectNumber 
                                        number="{comprasModel>QtdNecessaria}" 
                                        unit="{comprasModel>UnidadeMedida}" />
                                    <ObjectNumber 
                                        number="{comprasModel>QtdEstoque}" 
                                        unit="{comprasModel>UnidadeMedida}" 
                                        state="{= ${comprasModel>QtdEstoque} &lt; ${comprasModel>QtdNecessaria} ? 'Error' : 'Success' }" />
                                    <ObjectNumber 
                                        number="{comprasModel>QtdComprar}" 
                                        unit="{comprasModel>UnidadeMedida}" 
                                        state="{= ${comprasModel>QtdComprar} &gt; 0 ? 'Warning' : 'None' }" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
    
                    <!-- botao rodapé a direita -->
                    <HBox justifyContent="End" class="sapUiMediumMarginTop">
                        <Button id="btnGerarPedido"
                            text="Gerar pedido"
                            type="Emphasized"
                            icon="sap-icon://add"
                            press=".onGerarPedido" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>