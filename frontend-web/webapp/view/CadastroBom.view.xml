<mvc:View controllerName="zpeweb.controller.CadastroBom"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns="sap.m">
    
    <Page id="bomPage" 
        title="{i18n>cardBOM}" 
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true"
        class="sapUiContentPadding">

        <headerContent>
            <Button 
                icon="sap-icon://palette" 
                type="Transparent"
                tooltip="{i18n>tooltipToggleTheme}"
                press=".onToggleTheme" />
        </headerContent>

        <content>
            <!-- Barra inicial de Buscar PA -->
            <OverflowToolbar class="sapUiSmallMarginBottom">
                <Label text="{i18n>lblCodPA}" labelFor="iptCodigoPA"/>
                <Input id="iptCodigoPA" 
                    placeholder="{i18n>plcCodMat}" 
                    type="Number" 
                    liveChange=".onInputLiveChange" 
                    showValueHelp="true" 
                    valueHelpRequest=".onValueHelpMaterial"  
                    width="12rem"
                    class="sapUiSmallMarginEnd"/>
                    
                <Button 
                    icon="sap-icon://search" 
                    text="{i18n>btnBuscar}" 
                    type="Emphasized" 
                    press=".onBuscar"/>
            </OverflowToolbar>
            
            <!-- Container para o cadastro do BOM -->
            <VBox id="containerCadastroBom" visible="{viewModel>/bMostrarCadastroBom}" width="100%">
                <Title text="{i18n>titleBOM} {viewModel>/tituloProduto}" 
                    titleStyle="H3" 
                    class="sapUiSmallMarginBottom" />

                <!-- Caixa de cadastro -->
                <Panel headerText="{i18n>headerTxtBOM}" expandable="false" class="sapUiSmallMarginBottom">
                    <f:SimpleForm 
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="6" emptySpanL="6" emptySpanM="4" emptySpanS="0"
                        columnsXL="1" columnsL="1" columnsM="1">
                        <f:content>
                            <Label text="{i18n>lblCodMP}" labelFor="iptMateriaPrima"/>
                            <Input id="iptMateriaPrima" 
                                placeholder="{i18n>plcCodMat}" 
                                type="Number" 
                                liveChange=".onInputLiveChange" 
                                width="100%" 
                                showValueHelp="true" 
                                valueHelpRequest=".onValueHelpMaterial" 
                                tooltip="{i18n>toolTipMP}" 
                                app:entitySet="/ZshPeMateriaPrimaSet"/>

                            <Label text="{i18n>lblQtdMat}" labelFor="iptQuantidade"/>
                            <Input id="iptQuantidade" type="Number" liveChange=".onInputLiveChange" width="100%"/>
                        </f:content>
                    </f:SimpleForm>
                    <!-- Botões de ação -->
                    <HBox class="sapUiSmallMarginTopBottom">
                        <Button 
                            text="{i18n>btnCadastro}" 
                            icon="sap-icon://add" 
                            type="Emphasized"
                            press=".onAdicionarMp" 
                            class="sapUiTinyMarginEnd" />
                    </HBox>
                </Panel>

                <!-- Tabela da Lista BOM -->
                <Table 
                    id="tableBomItems" 
                    items="{/ZTPE_BOMSet}" 
                    alternateRowColors="true"
                    growing="true"
                    growingThreshold="10">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>tableBOM}" level="H4"/>
                            <ToolbarSpacer/>
                            <Button 
                                icon="sap-icon://edit" 
                                text="{i18n>btnEdit}" 
                                visible="{= !${viewModel>/modoEdicao}}"
                                press=".onAlternarEdicao"/>

                            <Button 
                                icon="sap-icon://save"
                                text="{i18n>btnSave}"
                                type="Accept"
                                visible="{= ${viewModel>/modoEdicao} === true}"
                                press=".onSalvarAlteracoes"/>

                            <Button
                                icon="sap-icon://decline"
                                text="{i18n>btnCancel}"
                                type="Reject"
                                visible="{= ${viewModel>/modoEdicao} === true}"
                                press=".onCancelarAlteracoes"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    
                    <columns>
                        <Column width="6rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>colCodPA}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>colDescPA}" />
                        </Column>
                        <Column width="6rem">
                            <Text text="{i18n>colCodMP}" />
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>colDescMP}" />
                        </Column>
                        <Column width="7rem" hAlign="End">
                            <Text text="{i18n>colQtdMP}" />
                        </Column>
                        <Column width="3rem" hAlign="Center">
                            <Text text=""/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{Codigopa}" />
                                <Text text="{Descricaopa}" />
                                <Text text="{Codigomp}" />
                                <Text text="{Descricaomp}" />
                                <Input value="{Quantidademp}" type="Number" liveChange=".onInputLiveChange" width="100%" maxLength="4" editable="{viewModel>/modoEdicao}" valueLiveUpdate="true"/>

                                <Button 
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    press="onDeletarItem"
                                    tooltip="{i18n>toolTipDelete}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>