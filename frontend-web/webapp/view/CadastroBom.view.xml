<mvc:View controllerName="zpeweb.controller.CadastroBom"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    
    <Page id="bomPage" 
        title="Estrutura de Produto (BOM)" 
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true"
        class="sapUiContentPadding">
        <content>
            <!-- Barra inicial de Buscar PA -->
            <OverflowToolbar class="sapUiSmallMarginBottom">
                <Label text="Insira o código do Produto Acabado:" labelFor="iptCodigoPA"/>
                <Input id="iptCodigoPA" placeholder="0000"  type="Number" liveChange=".onInputLiveChange" showValueHelp="true" valueHelpRequest=".onValueHelpMaterial" maxLength="4" width="8rem"/>
                    
                <Button 
                    icon="sap-icon://search" 
                    text="Buscar" 
                    type="Emphasized" 
                    press=".onBuscarProduto"/>

            </OverflowToolbar>
            
            <!-- Container para o cadastro do BOM -->
            <VBox id="containerCadastroBom" visible="{viewModel>/bMostrarCadastroBom}">
                <Title text="BOM do Produto: {viewModel>/tituloProduto} " 
                    titleStyle="H3" 
                    class="sapUiSmallMarginBottom" />

                <!-- Caixa de cadastro -->
                <Panel headerText="Cadastro de Matérias-Primas que compõe o Produto Acabado" expandable="false" class="sapUiSmallMarginBottom">
                    <f:SimpleForm 
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4" emptySpanL="4" emptySpanM="0" emptySpanS="0"
                        columnsXL="1" columnsL="1" columnsM="1">
                        <f:content>
                            
                            <Label text="Código da matéria-prima:" labelFor="iptMateriaPrima"/>
                            <Input id="iptMateriaPrima" placeholder="0000" type="Number" liveChange=".onInputLiveChange" maxLength="4" width="10rem" showValueHelp="true" valueHelpRequest=".onSelecionarMP" tooltip="Selecionar Matéria-Prima"/>

                            <Label text="Quantidade do material:" labelFor="iptQuantidade"/>
                            <Input id="iptQuantidade" type="Tel" maxLength="4" width="10rem"/>

                        </f:content>
                    </f:SimpleForm>

                    <!-- Botões de ação -->
                    <HBox class="sapUiLargeMarginBegin sapUiSmallMarginTopBottom">
                        <Button 
                            text="Cadastrar" 
                            icon="sap-icon://add" 
                            type="Emphasized"
                            press=".onAdicionarMp" 
                            class="sapUiTinyMarginEnd" />
                        
                    </HBox>
                </Panel>

                <!-- Tabela da Lista BOM -->
                <Table 
                    id="tableBomItems" items="{/ZTPE_BOMSet}" alternateRowColors="true">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Matérias-Primas do Produto" level="H4"/>
                            <ToolbarSpacer/>
                            <Button 
                                icon="sap-icon://edit" 
                                text="Editar" 
                                visible="{= !${viewModel>/modoEdicao}}"
                                press=".onAlternarEdicao"/>

                            <Button 
                                icon="sap-icon://edit"
                                text="Salvar"
                                type="Accept"
                                visible="{= ${viewModel>/modoEdicao} === true}"
                                press=".onSalvarAlteracoes"/>

                            <Button
                                icon="sap-icon://decline"
                                text="Cancelar"
                                type="Reject"
                                visible="{= ${viewModel>/modoEdicao} === true}"
                                press=".onCancelarAlteracoes"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    
                    <columns>
                        <Column width="15%"><Text text="{i18n>colCodPA}" /></Column>
                        <Column width="25%"><Text text="{i18n>colDescPA}" /></Column>
                        <Column width="15%"><Text text="{i18n>colCodMP}" /></Column>
                        <Column width="25%"><Text text="{i18n>colDescMP}" /></Column>
                        <Column width="15%" hAlign="End"><Text text="{i18n>colQtdMP}" /></Column>
                        <Column width="5%" hAlign="Center"><Text text=""/></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{Codigopa}" />
                                <Text text="{Descricaopa}" />
                                <Text text="{Codigomp}" />
                                <Text text="{Descricaomp}" />
                                <Input value="{Quantidademp}" width="auto" maxLength="4" editable="{viewModel>/modoEdicao}" valueLiveUpdate="true"/>

                                <Button 
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    press="onDeletarItem"
                                    tooltip="Excluir registro"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>