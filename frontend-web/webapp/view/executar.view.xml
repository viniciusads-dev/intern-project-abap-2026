<mvc:View controllerName="zpeweb.controller.ExecutarProducao"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page 
        id="executarPage"
        title="{i18n>executarPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        <content>
            <VBox class="sapUiSmallMargin">
                
                <!-- campo de busca -->
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Label text="Código Material:" labelFor="inputMaterial" class="sapUiTinyMarginEnd" />
                    <Input id="inputMaterial"
                        width="200px"
                        placeholder="Digite o código..."
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpMaterial"
                        class="sapUiTinyMarginEnd" />
                    <Button id="btnBuscar"
                        text="Buscar"
                        type="Emphasized"
                        icon="sap-icon://search"
                        press=".onBuscar" />
                </HBox>

                <!-- container resultado -->
                <VBox id="panelResultado" class="sapUiSmallMarginTop" visible="true">
                    
                    <!-- barra nome e botão processar -->
                    <FlexBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                        <Title id="txtNomeProduto" text="NOME-PA" level="H2" />
                        <Button id="btnProcessar"
                            text="Processar"
                            type="Emphasized"
                            icon="sap-icon://process"
                            press=".onProcessar" />
                    </FlexBox>

                    <!-- tabela com componentes da BOM -->
                    <Table id="tblMateriasPrima" inset="false">
                        <columns>
                            <Column width="25%">
                                <Text text="Cod. Matéria-Prima" />
                            </Column>
                            <Column width="50%">
                                <Text text="Descrição" />
                            </Column>
                            <Column hAlign="End" width="25%">
                                <Text text="Qtd. Necessária" />
                            </Column>
                        </columns>
                        <items>
                            <!-- dados de exemplo -->
                            <ColumnListItem>
                                <cells>
                                    <Text text="00" />
                                    <Text text="EXEMPLO" />
                                    <ObjectNumber number="127" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>