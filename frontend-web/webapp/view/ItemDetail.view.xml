<mvc:View
    controllerName="zpeweb.controller.ItemDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:microchart="sap.suite.ui.microchart"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>titleItemDetail}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            
            <!-- CABEÇALHO DO MATERIAL -->
            <!-- O binding será feito dinamicamente no Controller para a entidade ZSTR_ESTOQUE_ODATASet -->
            <Panel class="sapUiResponsiveMargin" width="auto">
                <content>
                    <ObjectHeader 
                        title="{Codigom} - {Descricaocm}" 
                        intro="{i18n>objHeaderItemIntro}" 
                        icon="sap-icon://product"
                        iconActive="false"
                        class="sapUiNoMarginBottom">
                        <attributes>
                            <ObjectAttribute title="Tipo" text="{path: 'Tipocm', formatter: '.formatMaterialType'}" />
                        </attributes>
                        <statuses>
                            <ObjectStatus title="Estoque Atual" text="{Quantidadem} {UnidadeMedidacm}" state="Success" />
                        </statuses>
                    </ObjectHeader>
                </content>
            </Panel>
            <!-- DASHBOARD DO MATERIAL -->
            <Panel class="sapUiResponsiveMargin" width="auto" headerText="Métricas de Movimentação">
                <HBox wrap="Wrap" justifyContent="SpaceAround" alignItems="Center" class="sapUiSmallMargin">
                    
                    <VBox alignItems="Center" class="sapUiMediumMarginEnd">
                        <Title text="Balanço (Entradas x Saídas)" level="H4" class="sapUiTinyMarginBottom" />
                        <microchart:ComparisonMicroChart size="M" scale="{UnidadeMedidacm}">
                            <microchart:data>
                                <microchart:ComparisonMicroChartData title="Entradas" value="{view>/metrics/totalIn}" color="Good" />
                                <microchart:ComparisonMicroChartData title="Saídas" value="{view>/metrics/totalOut}" color="Error" />
                            </microchart:data>
                        </microchart:ComparisonMicroChart>
                    </VBox>

                    <!-- Gráfico Radial: Saúde das Saídas (Giro de Estoque) -->
                    <VBox alignItems="Center">
                        <Title text="Volume de Saídas" level="H4" class="sapUiTinyMarginBottom" />
                        <microchart:RadialMicroChart 
                            size="M" 
                            percentage="{view>/metrics/outPercentage}" 
                            valueColor="{= ${view>/metrics/outPercentage} > 80 ? 'Critical' : 'Good' }" />
                    </VBox>

                </HBox>
            </Panel>
            <!-- TABELA DE LOGS DE MOVIMENTAÇÃO -->
            <Panel class="sapUiResponsiveMargin" width="auto">
                <content>
                    <Table 
                        id="tblLogs" 
                        items="{/ZTPE_LOG_MOVSet}" 
                        noDataText="{i18n>noDataLogs}">
                        
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{i18n>logTableTitle}" level="H2"/>
                                <ToolbarSpacer />
                                
                                <MenuButton text="Exportar">
                                    <menu>
                                        <Menu itemSelected=".onExport">
                                            <MenuItem text="Exportar como PDF" key="PDF" icon="sap-icon://pdf-attachment" />
                                            <MenuItem text="Exportar como CSV" key="CSV" icon="sap-icon://excel-attachment" />
                                        </Menu>
                                    </menu>
                                </MenuButton>
                                
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="30%"><Text text="{i18n>colLogDate}" /></Column>
                            <Column width="40%"><Text text="{i18n>colLogType}" /></Column>
                            <Column width="30%" hAlign="Right"><Text text="{i18n>colLogQty}" /></Column>
                        </columns>
                        
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{ path: 'Datal', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy HH:mm:ss' } }" />
                                    <Text text="{ path: 'Tipol', formatter: '.formatMovementType' }" />
                                    <ObjectNumber number="{ path: 'Quantidadel', formatter: '.formatQuantity' }" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

        </content>
    </Page>
</mvc:View>