<mvc:View controllerName="zpeweb.controller.ExecutarProducao"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page 
        id="executarPage"
        title="{i18n>executarPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">
        
        <headerContent>
            <Button 
                icon="sap-icon://palette" 
                type="Transparent"
                tooltip="{i18n>tooltipToggleTheme}"
                press=".onToggleTheme" />
        </headerContent>

        <content>
            <VBox class="sapUiSmallMargin">
                
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Label text="{i18n>inputPA}" labelFor="inputMaterial" class="sapUiTinyMarginEnd" />
                    <Input id="inputMaterial"
                        type="Number"
                        liveChange=".onInputLiveChange"
                        width="200px"
                        placeholder="{i18n>inputPAplaceholder}"
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpMaterial"
                        class="sapUiTinyMarginEnd" />
                    <Button id="btnBuscar"
                        text="{i18n>btnBuscar}"
                        type="Emphasized"
                        icon="sap-icon://search"
                        press=".onBuscar" />
                </HBox>

                <VBox id="panelResultado" class="sapUiSmallMarginTop" visible="true">
                    
                    <FlexBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                        <Title id="txtNomeProduto" text="" level="H2" />
                        <Button id="btnProcessar"
                            text="{i18n>btnProcessar}"
                            type="Emphasized"
                            icon="sap-icon://process"
                            press=".onProcessar" />
                    </FlexBox>

                    <Table id="tblMateriasPrima" inset="false" items="{bomModel>/}">
                        <columns>
                            <Column width="25%"><Text text="{i18n>colCodMP}" /></Column>
                            <Column width="50%"><Text text="{i18n>descricaoProd}" /></Column>
                            <Column hAlign="End" width="25%"><Text text="{i18n>quantidadeNec}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{bomModel>Codigomp}" />
                                    <Text text="{bomModel>Descricaocm}" />
                                    <ObjectNumber 
                                        number="{
                                            path: 'bomModel>Quantidademp',
                                            type: 'sap.ui.model.type.Float',
                                            formatOptions: {
                                                minFractionDigits: 0,
                                                maxFractionDigits: 3
                                            }
                                        }" 
                                        unit="{bomModel>UnidadeMedidacm}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>