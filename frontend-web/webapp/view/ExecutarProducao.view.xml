<mvc:View controllerName="zpeweb.controller.ExecutarProducao"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page 
        id="executarPage"
        title="{i18n>executarPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true"
        busy="{viewModel>/isBusy}">
        
        <headerContent>
            <Button icon="sap-icon://palette" type="Transparent" tooltip="{i18n>tooltipToggleTheme}" press=".onToggleTheme" />
        </headerContent>

        <content>
            <Panel headerText="{i18n>panelSelecaoMaterial}" class="sapUiResponsiveMargin" width="auto">
                <content>
                    <HBox alignItems="Center">
                        <Label text="{i18n>inputPA}" labelFor="inputMaterial" class="sapUiTinyMarginEnd" />
                        <Input id="inputMaterial"
                            type="Number"
                            liveChange=".onInputLiveChange"
                            width="200px"
                            placeholder="{i18n>inputPAplaceholder}"
                            showValueHelp="true"
                            valueHelpRequest=".onValueHelpMaterial"
                            class="sapUiTinyMarginEnd" />
                        <Button id="btnBuscar" text="{i18n>btnBuscar}" type="Emphasized" icon="sap-icon://search" press=".onBuscar" />
                    </HBox>
                </content>
            </Panel>

            <Panel id="panelResultado" headerText="{i18n>panelEstruturaBOM}" class="sapUiResponsiveMargin" width="auto" visible="{viewModel>/hasResults}">
                <content>
                    <FlexBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                        <Title id="txtNomeProduto" text="{viewModel>/headerTitle}" level="H3" />
                        <Button id="btnProcessar" text="{i18n>btnProcessar}" type="Emphasized" icon="sap-icon://process" press=".onProcessar" />
                    </FlexBox>

                    <Table id="tblMateriasPrima" 
                        alternateRowColors="true"
                        inset="false" 
                        items="{bomModel>/}">
                        <columns>
                            <Column width="25%"><Text text="{i18n>colCodMP}" /></Column>
                            <Column width="50%"><Text text="{i18n>descricaoProd}" /></Column>
                            <Column hAlign="End" width="25%"><Text text="{i18n>quantidadeNec}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{bomModel>Codigomp}" />
                                    <Text text="{bomModel>Descricaocm}" />
                                    <ObjectNumber 
                                        number="{
                                            path: 'bomModel>Quantidademp',
                                            type: 'sap.ui.model.type.Float',
                                            formatOptions: { minFractionDigits: 0, maxFractionDigits: 3 }
                                        }" 
                                        unit="{bomModel>UnidadeMedidacm}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>
        </content>
    </Page>
</mvc:View>