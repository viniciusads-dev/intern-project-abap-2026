<mvc:View controllerName="zpeweb.controller.UnidadeMedida"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true">
    <Page 
        id="unidadePage" 
        title="Manutenção de Unidades de Medida"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">

        <content>
            <VBox width="75%" class="sapUiSmallMargin">
                <OverflowToolbar height="5rem" class="sapUiMediumMarginBottom">
                    <Title text="Cadastro de Unidade de Medida"/>
                    <ToolbarSpacer/>
                    <Button 
                        icon="sap-icon://add" 
                        text="Nova Unidade" 
                        type="Emphasized" 
                        press=".onCriarUnidade" 
                        class="sapUiTinyMarginEnd"/>
                    <Button 
                        text="Excluir" 
                        icon="sap-icon://delete" 
                        type="Reject" 
                        press="onDeletarUnidade" />

                </OverflowToolbar>
                <Title text="Unidades Cadastradas"/>
                <Table id="tableUnidades" items="{/ZTPE_UNMEDIDASet}" mode="MultiSelect" width="100%">
                    <columns>
                        <Column id="colSigla" width="100px" ><Text id="txtSigla" text="Sigla"/></Column>
                        <Column id="colNomeTecnico"><Text id="txtNomeTecnico" text="Descrição" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="itemUnidade">
                            <cells>
                                <Text text="{Codigounm}" />
                                <Text text="{Descricaounm}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>