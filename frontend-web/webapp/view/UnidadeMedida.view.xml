<mvc:View controllerName="zpeweb.controller.UnidadeMedida"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true">
    <Page 
        id="unidadePage" 
        title="{i18n>pageUM}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">

        <headerContent>
            <Button 
                icon="sap-icon://palette" 
                type="Transparent"
                tooltip="{i18n>tooltipToggleTheme}"
                press=".onToggleTheme" />
        </headerContent>

        <content>
            <VBox width="50%" class="sapUiSmallMargin">
                <OverflowToolbar height="5rem" class="sapUiMediumMarginBottom">
                    <Title text="{i18n>titleUM}"/>
                    <ToolbarSpacer/>
                    <Button 
                        icon="sap-icon://add" 
                        text="{i18n>btnNovaUM}" 
                        type="Emphasized" 
                        press=".onCriarUnidade" 
                        class="sapUiTinyMarginEnd"/>
                    <Button 
                        text="{i18n>btnExcluir}" 
                        icon="sap-icon://delete" 
                        type="Reject" 
                        press="onDeletarUnidade" />
                </OverflowToolbar>

                <Table 
                id="tableUnidades" 
                items="{/ZTPE_UNMEDIDASet}" 
                mode="MultiSelect" 
                width="100%"
                alternateRowColors="true">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>tableUM}"/>
                            <ToolbarSpacer />
                            <Button 
                                icon="sap-icon://edit" 
                                text="{i18n>btnEdit}" 
                                visible="{= !${viewModel>/modoEdicao}}"
                                press=".onAlternarEdicao"/>

                            <Button 
                                icon="sap-icon://edit"
                                text="{i18n>btnSave}"
                                type="Accept"
                                visible="{viewModel>/modoEdicao}"
                                press=".onSalvarAlteracoes"/>
                            <Button
                                icon="sap-icon://decline"
                                text="{i18n>btnCancel}"
                                type="Reject"
                                visible="{viewModel>/modoEdicao}"
                                press=".onCancelarAlteracoes"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="colSigla" width="100px" ><Text id="txtSigla" text="{i18n>colSigla}"/></Column>
                        <Column id="colNomeTecnico"><Text id="txtNomeTecnico" text="{i18n>colDescUM}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="itemUnidade">
                            <cells>
                                <Text text="{Codigounm}" />
                                <Input value="{Descricaounm}" width="auto" maxLength="30" editable="{viewModel>/modoEdicao}" valueLiveUpdate="true"/>
                            </cells>
                        </ColumnListItem>
                    </items>            
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>