<mvc:View controllerName="zpeweb.controller.UnidadeMedida"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true">
    <Page id="unidadePage" title="Manutenção de Unidades de Medida">
        <content>
<VBox alignItems="Center">
    <!-- Botão de Ação em Destaque no Topo -->
    <Button 
        icon="sap-icon://add" 
        text="CADASTRAR NOVA UNIDADE" 
        type="Accept" 
        press=".onCriarUnidade" 
        width="400px" 
        class="sapUiMediumMarginBottom" />

    <!-- Tabela Compacta em Baixo -->
    <Table id="tableUnidades" width="500px">
        ...
    </Table>
</VBox>

            <VBox width="50%" class="sapUiSmallMargin">
                <OverflowToolbar height="5rem" class="sapUiMediumMarginBottom">
                    <Title text="Unidades Disponíveis"/>
                    <ToolbarSpacer />
                    <Button icon="sap-icon://add" text="Nova Unidade" type="Accept" press=".onCriarUnidade" class="sapUiTinyMarginEnd"/>
                </OverflowToolbar>

                <Table id="tableUnidades">
                    <columns>
                        <Column id="colSigla"><Text id="txtSigla" text="Sigla" /></Column>
                        <Column id="colNomeTecnico"><Text id="txtNomeTecnico" text="Unidade de Medida" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="itemUnidade">
                            <cells>

                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>