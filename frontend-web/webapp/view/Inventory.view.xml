<mvc:View
    controllerName="zpeweb.controller.Inventory"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:microchart="sap.suite.ui.microchart"
    xmlns="sap.m">
    
    <Page 
        id="inventoryPage"
        title="{i18n>inventoryPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">

        <headerContent>
            <Button 
                icon="sap-icon://palette" 
                type="Transparent"
                tooltip="{i18n>tooltipToggleTheme}"
                press=".onToggleTheme" />
        </headerContent>
        
        <content>
            <Panel class="sapUiResponsiveMargin" width="auto" expandable="true" expanded="true" headerText="Visão Global de Movimentações (Últimos 1000 registros)">
                <HBox wrap="Wrap" justifyContent="SpaceAround" alignItems="Center">
                    
                    <VBox alignItems="Center" width="20rem" class="sapUiSmallMargin">
                        <Title text="Entradas Totais" level="H4" class="sapUiTinyMarginBottom" />
                        <Text text="Total In: {view>/global/totalIn} | Total Out: {view>/global/totalOut}" class="sapUiSmallMargin" />
                        <microchart:InteractiveDonutChart displayedSegments="3" selectionEnabled="false">
                            <microchart:segments>
                                <microchart:InteractiveDonutChartSegment label="Entradas (Qtd)" value="{path: 'view>/global/totalIn', type: 'sap.ui.model.type.Float'}" color="Good"/>
                                <microchart:InteractiveDonutChartSegment label="Saídas (Qtd)" value="{path: 'view>/global/totalOut', type: 'sap.ui.model.type.Float'}" color="Error"/>
                            </microchart:segments>
                        </microchart:InteractiveDonutChart>
                    </VBox>
                    
                </HBox>
            </Panel>
            <Table 
                id="inventoryTable"
                autoPopinMode="true"
                width="auto"
                items="{
                    path: '/ZSTR_ESTOQUE_ODATASet', 
                    parameters: {countMode: 'Inline'}
                }"
                growing="true"
                growingScrollToLoad="true"
                growingThreshold="20"
                mode="None"
                class="sapUiResponsiveMargin">
                
                <headerToolbar>
                    <OverflowToolbar id="tableToolbar">
                        <Title 
                            id="tableTitle"
                            text="{i18n>inventoryTableTitle}"
                            level="H4"/>
                            
                        <Text 
                            id="recordCountText"
                            text="{
                                path: 'inventoryModel>/count',
                                formatter: '.formatBadgeCount'
                            }"/>
                        
                        <ToolbarSpacer id="spacer"/>
                        
                        <Button 
                            id="btnRegisterMovement"
                            text="{i18n>btnRegisterMovement}"
                            type="Emphasized"
                            icon="sap-icon://add"
                            press=".onRegisterMovement"/>
                        
                        <Button 
                            id="btnGenerateReport"
                            text="{i18n>btnGenerateReport}"
                            icon="sap-icon://excel-attachment"
                            press=".onGenerateReport"/>
                    </OverflowToolbar>
                </headerToolbar>
                
                <columns>
                    <Column id="colMaterial" width="16rem" importance="High" demandPopin="true" minScreenWidth="Phone">
                        <header>
                            <Text id="colMaterialHeader" text="{i18n>colCode}"/>
                        </header>
                    </Column>
                    
                    <Column 
                        id="colQuantity" 
                        width="10rem"
                        hAlign="End" 
                        importance="High"
                        demandPopin="true" 
                        minScreenWidth="Phone">
                        <header>
                            <Text id="colQuantityHeader" text="{i18n>colQuantity}"/>
                        </header>
                    </Column>

                    <Column 
                        id="UnidadeMedidacm" 
                        width="12rem"
                        importance="Medium"
                        demandPopin="true" 
                        minScreenWidth="Tablet">
                        <header>
                            <Text id="colUnitMeasureHeader" text="{i18n>colUnitMeasure}"/>
                        </header>
                    </Column>

                    <Column 
                        id="colTypeCm" 
                        width="12rem"
                        importance="Medium"
                        demandPopin="true" 
                        minScreenWidth="Tablet">
                        <header>
                            <Text id="colTypeCmHeader" text="{i18n>colTypeCm}"/>
                        </header>
                    </Column>
                    
                </columns>
                
                <items>
                    <ColumnListItem 
                        id="inventoryItem"
                        vAlign="Middle"
                        type="Navigation"
                        press=".onItemPress">
                        <cells>
                            <ObjectIdentifier
                                id="objIdentifier"
                                title="{Codigom}"
                                text="{Descricaocm}"/>
                            
                            <ObjectNumber
                                id="objNumber"
                                number="{Quantidadem}"
                                state="None"/>
                            
                            <Text 
                                id="objTypeMedida"
                                text="{= ${UnidadeMedidacm} + ' - ' + ${Descricaounm} }" />
                                
                            <Text 
                                id="typeCmText"
                                text="{path: 'Tipocm', formatter: '.formatMaterialType'}"/>
                        </cells>
                    </ColumnListItem>
                </items>
                
                <noData>
                    <IllustratedMessage
                        id="emptyMessage"
                        enableVerticalResponsiveness="true"
                        illustrationType="sapIllus-NoEntries"
                        title="{i18n>noDataTitle}"
                        description="{i18n>noDataDescription}"/>
                </noData>
            </Table>
        </content>
        
        <footer>
            <Bar id="inventoryFooterBar">
                <contentRight>
                    <Text 
                        id="lastUpdateText"
                        text="{path: 'inventoryModel>/lastUpdate', formatter: '.formatLastUpdate'}"
                        class="sapUiTinyMarginEnd"/>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>