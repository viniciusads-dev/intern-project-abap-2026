<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <SelectDialog
        id="pedidoHelpDialog"
        title="{i18n>dialogTitlePedidos}"
        search=".onPedidoHelpSearch"
        confirm=".onPedidoHelpConfirm"
        items="{/ZTPE_PED_CABSet}">
        
        <StandardListItem
            title="{Numeropedido}"
            description="{ path: 'Datap', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }"
            type="Active" />
            
    </SelectDialog>
    
</core:FragmentDefinition>