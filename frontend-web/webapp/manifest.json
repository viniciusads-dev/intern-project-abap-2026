{
  "_version": "1.60.0",
  "sap.app": {
    "id": "zpeweb",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0",
      "toolsId": "f1aa0cdc-fd49-429a-87e5-ce0b6d1b948d"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZPE_ADV_ODATA_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "i18nLocales": ["en", "pt"],
    "defaultLanguage": "pt"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zpeweb.i18n.i18n"
        }
      },
      "": {
          "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "mainService",
        "preload": false,
          "settings": {
            "defaultBindingMode": "TwoWay",
            "useBatch": true
          }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zpeweb.view",
        "async": true,
        "viewPath": "zpeweb.view"
      },
      "routes": [
        {
          "name": "RouteCockpit",
          "pattern": "",
          "target": [
            "TargetCockpit"
          ]
        },
        {
          "name": "RouteInventory",
          "pattern": "inventory",
          "target": [
            "TargetInventory"
          ]
        },
        {
          "name": "RouteNone",
          "pattern": "none",
          "target": [
            "TargetNone"
          ]
        },
        {
          "name": "RouteExecutarProducao",
          "pattern": "executar",
          "target": [
            "TargetExecutarProducao"
          ]
        },
        {
          "name": "RouteCadastroBom",
          "pattern": "cadastrobom",
          "target": [
            "TargetCadastroBom"
          ]
        },
        {
          "name": "RouteCentralCompras",
          "pattern": "centralcompras/:materialPA:",
          "target": [
            "TargetCentralCompras"
          ]
        },
        {
          "name": "RouteUnidadeMedida",
          "pattern": "unidademedida",
          "target": [
            "TargetUnidadeMedida"
          ]
        }
          
      ],
      "targets": {
        "TargetCockpit": {
          "id": "Cockpit",
          "name": "Cockpit"
        },
        "TargetInventory": {
          "id": "Inventory",
          "name": "Inventory"
        },
        "TargetNone": {
          "id": "None",
          "name": "None"
        },
        "TargetExecutarProducao": {
          "id": "Executar",
          "name": "Executar"
        },
        "TargetCadastroBom": {
          "id": "CadastroBom",
          "name": "CadastroBom"
        },
        "TargetCentralCompras": {
          "id": "CentralCompras",
          "name": "CentralCompras"
        },
        "TargetUnidadeMedida": {
          "id": "UnidadeMedida",
          "name": "UnidadeMedida"
        }

      }
    },
    "rootView": {
      "viewName": "zpeweb.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
